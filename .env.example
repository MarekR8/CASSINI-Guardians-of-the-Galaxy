# Local settings for `docker compose`. Copy to `.env` (ignored by Git) and fill in your own values.
# Without .env the default stack runs offline with no sign-in.

# --- Profile `full`: Keycloak sign-in in the dashboard -------------------------------------------
# Uncomment both lines to start Keycloak and make the Gateway require tokens:
# COMPOSE_PROFILES=full
# CASSINI_AUTH_ENABLED=true

# Keycloak admin console (http://localhost:8180/admin). Demo-only account, choose your own password.
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=

# Password shared by the synthetic demo users demo-coordinator, demo-dispatcher, demo-responder and
# demo-resident (realm `cassini`, deploy/keycloak/realm.json). Demo-only, never a real credential.
CASSINI_DEMO_PASSWORD=

# Host ports bound to 127.0.0.1.
# CASSINI_PORT=5080
# CASSINI_KEYCLOAK_PORT=8180

# Optional online preparation / ORS live adapter. Leave blank for the offline exercise.
# Actual ORS setting when exported into the launcher or recording-script environment.
# The default Compose stack does not forward this key or enable live routing.
Integrations__Ors__ApiKey=
# Team-only preparation credentials (reserved fields, not automatically read by the runtime).
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=
FLYPIX_API_KEY=
KINEIS_API_KEY=
