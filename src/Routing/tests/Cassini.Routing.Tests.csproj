<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Cassini.Routing.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="../../../data/demo/routing/expected.json" Link="routing-fixtures/expected.json"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../../data/demo/routing/cases/*.json" Link="routing-fixtures/cases/%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../../data/demo/routing/valencia/glofas-forecast.mock.json" Link="routing-fixtures/glofas-forecast.mock.json"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
