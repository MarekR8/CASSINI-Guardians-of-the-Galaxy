<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Cassini.Messaging.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(EnableRabbitMq)' == 'true'">
    <ProjectReference Include="../RabbitMq/Cassini.Messaging.RabbitMq.csproj" />
  </ItemGroup>
  <PropertyGroup Condition="'$(EnableRabbitMq)' == 'true'">
    <DefineConstants>$(DefineConstants);MESSAGING_RABBITMQ</DefineConstants>
  </PropertyGroup>
</Project>
