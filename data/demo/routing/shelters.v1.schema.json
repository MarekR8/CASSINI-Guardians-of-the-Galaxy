{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CASSINI evacuation shelters v1",
  "description": "Shelters supplied by the client for one evacuation input. Each shelter is placed by WGS 84 position, by an OSM node ID from the graph, or by both.",
  "type": "object",
  "required": ["sheltersVersion", "scenario", "provenance", "shelters"],
  "properties": {
    "sheltersVersion": {"const": "cassini.shelters.v1"},
    "scenario": {"type": "string", "minLength": 1},
    "provenance": {
      "type": "object",
      "required": ["source", "mode"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "mode": {"enum": ["client", "synthetic"],
          "description": "client: list delivered by the operator; synthetic: invented for an exercise"},
        "preparedAt": {"type": ["string", "null"], "format": "date-time"},
        "note": {"type": ["string", "null"]}
      }
    },
    "shelters": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/shelter"}}
  },
  "$defs": {
    "shelter": {
      "type": "object",
      "required": ["id", "name", "capacity"],
      "anyOf": [{"required": ["longitude", "latitude"]}, {"required": ["nodeId"]}],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "longitude": {"type": "number", "minimum": -180, "maximum": 180},
        "latitude": {"type": "number", "minimum": -90, "maximum": 90},
        "nodeId": {"type": "integer", "minimum": 1,
          "description": "OSM node ID from the evacuation input. When given with a position, the two must agree within the snapping radius."},
        "capacity": {"type": "integer", "minimum": 1, "description": "Total places for evacuees"},
        "intakePerHour": {"type": ["integer", "null"], "minimum": 1,
          "description": "Arrivals per hour the entrance can process; null means not limited"},
        "stepFree": {"type": "boolean", "default": false,
          "description": "Step-free access confirmed for wheelchair users"}
      }
    }
  }
}
