<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests/**</DefaultItemExcludes>
  </PropertyGroup>
  <!-- -p:EnableRabbitMq=true adds the RabbitMQ bus (Integrations:Bus:Mode=live); the default build stays package-free. -->
  <PropertyGroup Condition="'$(EnableRabbitMq)' == 'true'">
    <DefineConstants>$(DefineConstants);MESSAGING_RABBITMQ</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(EnableRabbitMq)' == 'true'">
    <ProjectReference Include="../Shared/Messaging/RabbitMq/Cassini.Messaging.RabbitMq.csproj" />
  </ItemGroup>
  <!-- -p:EnableManagementPostgres=true stores Management in PostgreSQL (management_db) through EF Core migrations. -->
  <PropertyGroup Condition="'$(EnableManagementPostgres)' == 'true'">
    <DefineConstants>$(DefineConstants);MANAGEMENT_POSTGRES</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(EnableManagementPostgres)' == 'true'">
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.4" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.4" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup Condition="'$(EnableManagementPostgres)' != 'true'">
    <Compile Remove="Postgres/**" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Cassini.Management.Tests" />
    <ProjectReference Include="../Shared/Messaging/Cassini.Messaging.csproj" />
    <Content Include="../../data/demo/sheltering/sample-grouping.json" Link="sample-grouping.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
